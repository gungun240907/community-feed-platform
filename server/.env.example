PORT=5000
MONGO_URI=mongodb://localhost:27017/community-feed
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Razorpay (leave empty for dev mode - subscription activates without payment)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# OTP behaviour
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (REQUIRED for email OTPs - French language switch + new-device login verification)
# Free option for testing: https://mailtrap.io
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@devfeed.com

# Firebase Phone Auth (REQUIRED for real SMS OTP delivery - all non-French language switches)
# Web API key from Firebase Console -> Project settings -> General (public, safe to embed).
# The SMS is sent directly to the user's phone by Firebase; the server verifies the typed
# code via the identitytoolkit REST API and checks the returned phone number matches the user.
FIREBASE_API_KEY=your_firebase_web_api_key
# Set to true when testing against the local Auth emulator (firebase emulators:start --only auth)
# FIREBASE_EMULATOR=false

# Twilio - DEPRECATED for SMS OTP (Firebase now handles phone verification).
# Kept only for phone number normalization.
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_DEFAULT_COUNTRY_CODE=91

# NOTE: Codes are NEVER delivered over the realtime socket channel and never returned in
# API responses. This is intentional (security).
