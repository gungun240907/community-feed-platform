PORT=5000
MONGO_URI=mongodb://localhost:27017/community-feed
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Razorpay (leave empty for dev mode - subscription activates without payment)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Dev subscription activation (must be 'true' AND NODE_ENV != production to enable)
# ALLOW_DEV_ACTIVATE=true

# Twilio SMS (for phone-based OTP and password reset via SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# SMTP (optional - for subscription confirmation emails and OTP/password delivery)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@devfeed.com
